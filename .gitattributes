# Enforce LF line endings for all text files
* text=auto eol=lf

# Java source files
*.java     text eol=lf

# Maven build files
*.xml      text eol=lf

# Properties and config files
*.properties text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Markdown and documentation
*.md       text eol=lf
*.txt      text eol=lf

# Scripts (Linux-style line endings are important here)
*.sh       text eol=lf
*.gradle   text eol=lf

# Batch scripts (Windows-specific, keep CRLF)
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Ignore binary files (no line ending conversions)
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.jar      binary
*.class    binary
*.zip      binary
*.gz       binary
*.tar      binary
*.exe      binary
*.dll      binary
